# : Manager [[[

[mgr]
cwd = { fg = "{{base05-hash}}" }

# Find
find_keyword = { fg = "{{base08-hash}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{base08-hash}}", bold = true, italic = true }

# Marker
marker_copied = { fg = "{{tertiary-hash}}", bg = "{{tertiary-hash}}" }
marker_cut = { fg = "{{tertiary-hash}}", bg = "{{tertiary-hash}}" }
marker_marked = { fg = "{{base08-hash}}", bg = "{{base08-hash}}" }
marker_selected = { fg = "{{tertiary-hash}}", bg = "{{tertiary-hash}}" }

# Count
count_copied = { fg = "{{tertiary-hash}}", bg = "{{tertiary-hash}}" }
count_cut = { fg = "{{tertiary-hash}}", bg = "{{tertiary-hash}}" }
count_selected = { fg = "{{base00-hash}}", bg = "{{tertiary-hash}}" }

# Border
border_style  = { fg = "{{primary-hash}}" }

# : ]]]


# : Status [[[

[status]
overall = { fg = "{{primary-hash}}" }

# Progress
progress_label = { bold = true }
progress_normal = { fg = "{{primary-hash}}", bg = "{{base00-hash}}" }
progress_error = { fg = "{{base08-hash}}", bg = "{{base00-hash}}" }

# Permissions
perm_type = { fg = "{{secondary-hash}}" }
perm_write = { fg = "{{tertiary-hash}}" }
perm_exec = { fg = "{{base08-hash}}" }
perm_read = { fg = "{{tertiary-hash}}" }
perm_sep = { fg = "{{primary-hash}}" }

# : ]]]


# : Mode [[[

[mode]

normal_main = { bg = "{{primary-hash}}", fg = "{{base00-hash}}", bold = true }
normal_alt  = { bg = "{{base01-hash}}", fg = "{{base06-hash}}" }

select_main = { bg = "{{secondary-hash}}", fg = "{{base00-hash}}", bold = true }
select_alt  = { bg = "{{base01-hash}}", fg = "{{base06-hash}}" }

unset_main = { bg = "{{tertiary-hash}}", fg = "{{base00-hash}}", bold = true }
unset_alt  = { bg = "{{base01-hash}}", fg = "{{base06-hash}}" }

# : ]]]


# : Input [[[

[input]
border = { fg = "{{primary-hash}}" }
title = {}
value = { fg = "{{base05-hash}}" }
selected = { reversed = true }

# : ]]]


# : Tabs [[[

[tabs]
active = { fg = "{{base00-hash}}", bold = true, bg = "{{primary-hash}}" }
inactive = { fg = "{{secondary-hash}}", bg = "{{base00-hash}}" }
sep_inner = { open = "", close = "" }

# : ]]]


# : Completion [[[

[cmp]
border = { fg = "{{primary-hash}}", bg = "{{base00-hash}}" }

# : ]]]


# : Tasks [[[

[tasks]
border = { fg = "{{primary-hash}}" }
title = {}
hovered = { fg = "{{tertiary-hash}}", underline = true }

# : ]]]


# : Which [[[

[which]
cols = 3
mask = { bg = "{{base00-hash}}" }
cand = { fg = "{{primary-hash}}" }
rest = { fg = "{{base00-hash}}" }
desc = { fg = "{{base05-hash}}" }
separator = " ▶ "
separator_style = { fg = "{{base05-hash}}" }

# : ]]]

# : Spotter [[[

[spot]
border   = { fg = "{{primary-hash}}" }
title    = { fg = "{{primary-hash}}" }
tbl_col  = { fg = "{{base05-hash}}" }
tbl_cell = { fg = "{{base05-hash}}", bg = "{{base00-hash}}" }

# : ]]]


# : Help [[[

[help]
on = { fg = "{{base05-hash}}" }
run = { fg = "{{base05-hash}}" }
hovered = { reversed = true, bold = true }
footer = { fg = "{{base00-hash}}", bg = "{{secondary-hash}}" }

# : ]]]


# : Notify [[[

[notify]
title_info = { fg = "{{tertiary-hash}}" }
title_warn = { fg = "{{primary-hash}}" }
title_error = { fg = "{{base08-hash}}" }

# : ]]]


# : File-specific styles [[[

[filetype]

rules = [
    # Images
    { mime = "image/*", fg = "{{primary-hash}}" },

    # Media
    { mime = "{audio,video}/*", fg = "{{tertiary-hash}}" },

    # Archives
    { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{secondary-hash}}" },

    # Documents
    { mime = "application/{pdf,doc,rtf}", fg = "{{tertiary-hash}}" },

    # Special files
    { mime = "*", is = "orphan", fg = "{{base00-hash}}", bg = "{{base08-hash}}" },
    { mime = "application/*exec*", fg = "{{base08-hash}}" },

    # Fallback
    { url = "*", fg = "{{base05-hash}}" },
    { url = "*/", fg = "{{primary-hash}}" },
]

# : ]]]


