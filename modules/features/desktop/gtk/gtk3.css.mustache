@define-color accent_color {{primary-hash}};
@define-color accent_bg_color {{primary-hash}};
@define-color accent_fg_color {{base00-hash}};

@define-color destructive_bg_color {{red-hash}};
@define-color destructive_fg_color {{base00-hash}};

@define-color error_bg_color {{red-hash}};
@define-color error_fg_color {{base00-hash}};

@define-color window_bg_color {{base00-hash}};
@define-color window_fg_color {{base05-hash}};

@define-color view_bg_color {{base00-hash}};
@define-color view_fg_color {{base05-hash}};

@define-color headerbar_bg_color {{base00-hash}};
@define-color headerbar_fg_color {{base05-hash}};
@define-color headerbar_backdrop_color @window_bg_color;

@define-color popover_bg_color {{base00-hash}};
@define-color popover_fg_color {{base05-hash}};

@define-color card_bg_color {{base00-hash}};
@define-color card_fg_color {{base05-hash}};

@define-color dialog_bg_color {{base00-hash}};
@define-color dialog_fg_color {{base05-hash}};

@define-color overview_bg_color {{base00-hash}};
@define-color overview_fg_color {{base05-hash}};

@define-color sidebar_bg_color {{base00-hash}};
@define-color sidebar_fg_color {{base05-hash}};
@define-color sidebar_backdrop_color @window_bg_color;
@define-color sidebar_border_color @window_bg_color;

@define-color secondary_sidebar_bg_color {{base00-hash}};
@define-color secondary_sidebar_fg_color {{base05-hash}};

/* Focused selection states */
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;

/* Backdrop/unfocused states */
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_base_color @window_bg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;
